    "label": "Generate"
   },
   {
    "role": "button",
    "label": "Export"
   },
   {
    "role": "button",
    "label": "Save"
   }
  ]
 },
 "*kicad:sch:bom": {
  "sequence": [
   {
    "target": {
     "role": "menu",
     "label": "Tools"
    }
   },
